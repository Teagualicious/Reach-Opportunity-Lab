{
  "name": "reach-opportunity-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/validate-ohio-market.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "geometry:refresh": "node scripts/build-ohio-market.mjs",
    "geometry:validate": "node scripts/validate-ohio-market.mjs",
    "legacy-geometry:refresh": "node scripts/build-zcta-fixture.mjs",
    "legacy-geometry:validate": "node scripts/validate-zcta-fixture.mjs",
    "offline:context": "node scripts/build-offline-map-context.mjs",
    "offline:build": "node scripts/build-offline-review.mjs",
    "offline:validate": "node scripts/validate-offline-review.mjs",
    "offline:all": "npm run offline:context && npm run typecheck && npm run offline:build && npm run offline:validate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "maplibre-gl": "^5.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
